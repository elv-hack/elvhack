---
/**
 * 文章页背景：每次打开文章随机选一套图案（点阵 / 等高线 / 波形 / 蓝图 / 数据雨，见 src/scripts/reading-scenes.ts）。
 * 固定在视口、不随页面滚动；每一帧都只由“坐标 + 时间”算出来，不依赖上一帧，
 * 所以停留多久都不会积累颜色误差或残影。
 * - 同一会话里尽量不连续两次出现同一套
 * - 鼠标附近的图案轻微增强（只在有鼠标的设备上）；正文栏后面压淡，保证阅读
 * 30fps、标签页在后台时暂停；减少动态效果时只画一帧；没有 WebGL 时退回静态 CSS 点阵。
 * ⌘K 面板里可以换一套，或整体开关（localStorage: ambient = off）。
 */
---

<reading-backdrop aria-hidden="true"><canvas></canvas></reading-backdrop>

<style>
  reading-backdrop {
    position: fixed;
    inset: 0 0 auto;
    height: 100vh;
    height: 100lvh;
    z-index: -1;
    display: block;
    pointer-events: none;
    opacity: 0;
    transition: opacity 1s ease;
  }

  reading-backdrop[data-ready] {
    opacity: 1;
  }

  reading-backdrop[data-off] {
    display: none;
  }

  canvas {
    width: 100%;
    height: 100%;
  }

  /* 没有 WebGL：静态的 CSS 点阵 */
  reading-backdrop[data-fallback] {
    opacity: 0.6;
    background-image: radial-gradient(circle, var(--line-strong) 1px, transparent 1.6px);
    background-size: 22px 22px;
  }

  reading-backdrop[data-fallback] canvas {
    display: none;
  }
</style>

<script>
  import { toRgb } from '@/scripts/color';
  import { Loop } from '@/scripts/loop';
  import { fragmentFor, scenes, type Scene } from '@/scripts/reading-scenes';
  import { hasFinePointer, prefersReducedMotion, themeColors } from '@/scripts/theme';

  /** 宽度不变、高度变化小于这个比例时（手机地址栏）不重设画布 */
  const MINOR_HEIGHT_CHANGE = 0.2;
  const UNIFORMS = ['uRes', 'uTime', 'uDpr', 'uBg', 'uInk', 'uAccent', 'uCol', 'uCalm', 'uPointer', 'uLens'];
  const VERT = `attribute vec2 p; void main() { gl_Position = vec4(p, 0.0, 1.0); }`;

  /** 随机挑一套，尽量不和上一次打开文章时相同 */
  const pickScene = (): Scene => {
    let last: string | null = null;
    try {
      last = sessionStorage.getItem('backdrop-last');
    } catch {}
    const pool = scenes.filter((scene) => scene.id !== last);
    return pool[Math.floor(Math.random() * pool.length)];
  };

  const remember = (scene: Scene) => {
    try {
      sessionStorage.setItem('backdrop-last', scene.id);
    } catch {}
  };

  const disabled = () => {
    try {
      return localStorage.getItem('ambient') === 'off';
    } catch {
      return false;
    }
  };

  class ReadingBackdrop extends HTMLElement {
    #gl: WebGLRenderingContext | null = null;
    #program: WebGLProgram | null = null;
    #scene: Scene = scenes[0];
    #u: Record<string, WebGLUniformLocation | null> = {};
    #canvas!: HTMLCanvasElement;
    #loop!: Loop;
    #resize?: ResizeObserver;
    #reduce = prefersReducedMotion();
    #fine = hasFinePointer();
    #size = { width: 0, height: 0 };
    #dpr = 1;
    #start = performance.now();
    #frame = 0;
    #pointer = { x: -9999, y: -9999, lens: 0, target: 0 };

    connectedCallback() {
      this.#canvas = this.querySelector('canvas')!;
      if (!this.#setup(pickScene())) {
        this.toggleAttribute('data-fallback', true);
        this.#applyToggle();
        document.addEventListener('ambientchange', this.#applyToggle);
        return;
      }
      this.#colors();
      this.#loop = new Loop(this, (now) => {
        // 动得很慢，30fps 足够
        if (++this.#frame % 2) return;
        this.#draw(now);
      });
      this.#resize = new ResizeObserver(() => this.#layout());
      this.#resize.observe(this);
      document.addEventListener('themechange', this.#onTheme);
      document.addEventListener('ambientchange', this.#applyToggle);
      document.addEventListener('backdrop:next', this.#next);
      if (this.#fine) {
        addEventListener('pointermove', this.#onPointer, { passive: true });
        document.documentElement.addEventListener('pointerleave', this.#onLeave);
      }
      this.#applyToggle();
      this.#loop.start();
      requestAnimationFrame(() => this.toggleAttribute('data-ready', true));
    }

    disconnectedCallback() {
      this.#loop?.stop();
      this.#resize?.disconnect();
      document.removeEventListener('themechange', this.#onTheme);
      document.removeEventListener('ambientchange', this.#applyToggle);
      document.removeEventListener('backdrop:next', this.#next);
      removeEventListener('pointermove', this.#onPointer);
      document.documentElement.removeEventListener('pointerleave', this.#onLeave);
    }

    #setup(scene: Scene): boolean {
      const gl =
        this.#gl ?? this.#canvas.getContext('webgl', { antialias: false, alpha: false, depth: false, powerPreference: 'low-power' });
      if (!gl) return false;
      const compile = (type: number, source: string) => {
        const shader = gl.createShader(type)!;
        gl.shaderSource(shader, source);
        gl.compileShader(shader);
        if (gl.getShaderParameter(shader, gl.COMPILE_STATUS)) return shader;
        console.warn(`[backdrop:${scene.id}]`, gl.getShaderInfoLog(shader));
        return null;
      };
      const vs = compile(gl.VERTEX_SHADER, VERT);
      const fs = compile(gl.FRAGMENT_SHADER, fragmentFor(scene));
      if (!vs || !fs) return false;
      const program = gl.createProgram()!;
      gl.attachShader(program, vs);
      gl.attachShader(program, fs);
      gl.bindAttribLocation(program, 0, 'p');
      gl.linkProgram(program);
      if (!gl.getProgramParameter(program, gl.LINK_STATUS)) return false;
      if (this.#program) gl.deleteProgram(this.#program);
      this.#program = program;
      gl.useProgram(program);
      if (!this.#gl) {
        gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
        gl.enableVertexAttribArray(0);
        gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);
      }
      this.#u = {};
      for (const name of UNIFORMS) this.#u[name] = gl.getUniformLocation(program, name);
      this.#gl = gl;
      this.#scene = scene;
      this.dataset.scene = scene.id;
      remember(scene);
      return true;
    }

    /** ⌘K“换一套文章背景”：按顺序切到下一套 */
    #next = () => {
      if (!this.#gl) return;
      const i = scenes.indexOf(this.#scene);
      if (!this.#setup(scenes[(i + 1) % scenes.length])) return;
      this.#colors();
      this.#layout(true);
      document.dispatchEvent(new CustomEvent('backdrop:changed', { detail: this.#scene.label }));
    };

    #applyToggle = () => {
      const off = disabled();
      this.toggleAttribute('data-off', off);
      if (this.#loop) this.#loop.paused = off || this.#reduce;
      if (!off && this.#gl) this.#layout(true);
    };

    #colors() {
      const gl = this.#gl!;
      const { bg, fg, accent } = themeColors();
      gl.uniform3fv(this.#u.uBg, toRgb(bg));
      gl.uniform3fv(this.#u.uInk, toRgb(fg));
      gl.uniform3fv(this.#u.uAccent, toRgb(accent));
    }

    #onTheme = () => {
      this.#colors();
      if (this.#loop.paused) this.#draw(performance.now());
    };

    #layout(force = false) {
      const rect = this.getBoundingClientRect();
      if (!rect.width || !rect.height) return;
      const minor =
        Math.round(rect.width) === Math.round(this.#size.width) &&
        Math.abs(rect.height - this.#size.height) < this.#size.height * MINOR_HEIGHT_CHANGE;
      if (minor && !force) return;
      this.#size = { width: rect.width, height: rect.height };

      const gl = this.#gl!;
      this.#dpr = Math.min(devicePixelRatio || 1, 1.5);
      this.#canvas.width = Math.round(rect.width * this.#dpr);
      this.#canvas.height = Math.round(rect.height * this.#dpr);
      gl.viewport(0, 0, this.#canvas.width, this.#canvas.height);
      gl.uniform2f(this.#u.uRes, this.#canvas.width, this.#canvas.height);
      gl.uniform1f(this.#u.uDpr, this.#dpr);

      // 正文栏在视口中的横向范围；窄屏正文铺满，就整体压淡
      const body = document.querySelector('post-body')?.getBoundingClientRect();
      if (body && body.width < rect.width * 0.86) {
        gl.uniform2f(this.#u.uCol, body.left / rect.width, body.right / rect.width);
        gl.uniform1f(this.#u.uCalm, 0.35);
      } else {
        gl.uniform2f(this.#u.uCol, -0.2, 1.2);
        gl.uniform1f(this.#u.uCalm, 0.55);
      }
      this.#draw(performance.now());
    }

    #onPointer = (event: PointerEvent) => {
      this.#pointer.x = event.clientX * this.#dpr;
      this.#pointer.y = this.#canvas.height - event.clientY * this.#dpr;
      this.#pointer.target = 1;
    };

    #onLeave = () => (this.#pointer.target = 0);

    #draw(now: number) {
      const gl = this.#gl;
      if (!gl || this.hasAttribute('data-off')) return;
      const p = this.#pointer;
      p.lens += (p.target - p.lens) * 0.15;
      // 减少动态效果时停在一个固定时刻
      gl.uniform1f(this.#u.uTime, this.#reduce ? 12 : (now - this.#start) / 1000);
      gl.uniform2f(this.#u.uPointer, p.x, p.y);
      gl.uniform1f(this.#u.uLens, p.lens);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
    }
  }

  if (!customElements.get('reading-backdrop')) customElements.define('reading-backdrop', ReadingBackdrop);
</script>
