---
/**
 * 文章页背景。默认是首页挪过来的粒子流场（阅读模式），也可以在 ⌘K 面板里换成“星云漂流”或关闭。
 * 渲染器在 src/scripts/backdrops/；这里只负责选模式、循环、尺寸、主题和正文栏遮罩。
 * 所有设备都持续缓慢流动（触屏设备粒子更少）；减少动态效果时只渲染一帧。
 * 高度用 100lvh：手机地址栏收起 / 弹出时画布尺寸不变，不会被重置。
 */
---

<ambient-field aria-hidden="true"></ambient-field>

<style>
  ambient-field {
    --c0: 30%;
    --c1: 70%;
    --calm: 0.3;
    position: fixed;
    inset: 0 0 auto;
    height: 100vh;
    height: 100lvh;
    z-index: -1;
    display: block;
    pointer-events: none;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  ambient-field[data-ready] {
    opacity: 1;
  }

  ambient-field :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* 流场：正文栏那一段压暗，两侧页边保持清楚 */
  ambient-field :global(canvas.flow) {
    mask-image: linear-gradient(
      to right,
      #000 calc(var(--c0) - 8%),
      rgb(0 0 0 / var(--calm)) var(--c0),
      rgb(0 0 0 / var(--calm)) var(--c1),
      #000 calc(var(--c1) + 8%)
    );
  }
</style>

<script>
  import { FlowBackdrop } from '@/scripts/backdrops/flow';
  import { NebulaBackdrop } from '@/scripts/backdrops/nebula';
  import { backdropModes, type Backdrop, type BackdropMode } from '@/scripts/backdrops/types';
  import { Loop } from '@/scripts/loop';
  import { hasFinePointer, prefersReducedMotion } from '@/scripts/theme';

  /** 高度变化小于这个比例时（例如手机地址栏），不重建画布 */
  const MINOR_HEIGHT_CHANGE = 0.2;

  /** 读取访客选择的背景模式，默认流场 */
  const savedMode = (): BackdropMode => {
    try {
      const value = localStorage.getItem('ambient');
      if (value === 'on') return 'flow';
      if (backdropModes.includes(value as BackdropMode)) return value as BackdropMode;
    } catch {}
    return 'flow';
  };

  class AmbientField extends HTMLElement {
    #backdrop: Backdrop | null = null;
    #loop!: Loop;
    #resize?: ResizeObserver;
    #reduce = prefersReducedMotion();
    #size = { width: 0, height: 0 };

    connectedCallback() {
      this.#loop = new Loop(this, (now) => this.#backdrop?.draw(now));
      this.#resize = new ResizeObserver(() => this.#layout());
      this.#resize.observe(this);
      document.addEventListener('themechange', this.#onTheme);
      document.addEventListener('ambientchange', this.#mount);
      this.#mount();
      this.#loop.start();
      requestAnimationFrame(() => this.toggleAttribute('data-ready', true));
    }

    disconnectedCallback() {
      this.#loop.stop();
      this.#resize?.disconnect();
      document.removeEventListener('themechange', this.#onTheme);
      document.removeEventListener('ambientchange', this.#mount);
      this.#backdrop?.destroy();
    }

    #mount = () => {
      this.#backdrop?.destroy();
      this.#backdrop = null;
      const mode = savedMode();
      this.dataset.mode = mode;
      if (mode !== 'off') {
        const options = { lite: !hasFinePointer() };
        this.#backdrop = mode === 'nebula' ? new NebulaBackdrop(this, options) : new FlowBackdrop(this, options);
      }
      this.#size = { width: 0, height: 0 };
      this.#layout();
      this.#loop.paused = this.#reduce || !this.#backdrop;
    };

    #layout() {
      const rect = this.getBoundingClientRect();
      if (!rect.width || !rect.height) return;
      // 宽度不变、高度只是小幅变化（地址栏、键盘之类）时保持原样，避免整片重置
      const minor =
        Math.round(rect.width) === Math.round(this.#size.width) &&
        Math.abs(rect.height - this.#size.height) < this.#size.height * MINOR_HEIGHT_CHANGE;
      if (minor) return;
      this.#size = { width: rect.width, height: rect.height };
      // 正文栏在视口中的横向范围，写给流场的遮罩
      const body = document.querySelector('post-body')?.getBoundingClientRect();
      if (body && body.width < rect.width * 0.86) {
        this.style.setProperty('--c0', `${((body.left / rect.width) * 100).toFixed(1)}%`);
        this.style.setProperty('--c1', `${((body.right / rect.width) * 100).toFixed(1)}%`);
        this.style.setProperty('--calm', '0.3');
      } else {
        // 窄屏正文铺满，整体压暗
        this.style.setProperty('--c0', '-10%');
        this.style.setProperty('--c1', '110%');
        this.style.setProperty('--calm', '0.45');
      }
      this.#backdrop?.resize(rect.width, rect.height);
    }

    #onTheme = () => {
      this.#backdrop?.colors();
      if (this.#loop.paused) this.#backdrop?.draw(performance.now());
    };
  }

  if (!customElements.get('ambient-field')) customElements.define('ambient-field', AmbientField);
</script>
