---
/**
 * 个人链接图标。
 * variant="icons"：一排圆形图标按钮（页脚、关于页“在线”一行）
 * variant="cards"：带名称和账号的卡片（关于页“联系”）
 */
import { socialLinks } from '@/lib/social';

export interface Props {
  variant?: 'icons' | 'cards';
  /** 不显示 RSS（例如只列个人主页的地方） */
  rss?: boolean;
}

const { variant = 'icons', rss = true } = Astro.props;
const links = socialLinks.filter((link) => rss || link.id !== 'rss');
---

<ul class:list={['social', variant]}>
  {
    links.map((link) => (
      <li>
        <a
          href={link.href}
          data-brand={link.id}
          aria-label={variant === 'icons' ? `${link.label} ${link.handle}` : undefined}
          title={variant === 'icons' ? `${link.label} · ${link.handle}` : undefined}
          {...(link.external ? { target: '_blank', rel: 'me noopener' } : {})}
          data-spotlight={variant === 'cards' ? '' : undefined}
        >
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path d={link.path} fill="currentColor" />
          </svg>
          {variant === 'cards' && (
            <span class="text">
              <span class="label mono">{link.label}</span>
              <span class="handle">{link.handle}</span>
            </span>
          )}
          {variant === 'cards' && link.external && (
            <span class="arrow" aria-hidden="true">
              ↗
            </span>
          )}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  /* ---- 图标按钮 ---- */
  .icons a {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    color: var(--fg-muted);
    transition:
      color 0.2s,
      background-color 0.2s,
      border-color 0.2s,
      transform 0.25s var(--ease-out);
  }

  .icons a:hover,
  .icons a:focus-visible {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
    transform: translateY(-2px);
  }

  .icons svg {
    width: 16px;
    height: 16px;
  }

  /* ---- 卡片 ---- */
  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .cards a {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    height: 100%;
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color 0.2s;
  }

  .cards a:hover {
    border-color: var(--accent-ink);
  }

  .cards svg {
    flex: none;
    width: 22px;
    height: 22px;
    color: var(--fg);
    transition:
      color 0.2s,
      transform 0.3s var(--ease-out);
  }

  .cards a:hover svg {
    color: var(--accent-ink);
    transform: scale(1.12) rotate(-6deg);
  }

  .text {
    display: grid;
    min-width: 0;
  }

  .label {
    font-size: var(--step--2);
    color: var(--fg-faint);
    text-transform: uppercase;
  }

  .handle {
    font-size: var(--step-1);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .arrow {
    margin-left: auto;
    color: var(--fg-muted);
    transition: transform 0.3s var(--ease-out);
  }

  .cards a:hover .arrow {
    transform: translate(3px, -3px);
    color: var(--accent-ink);
  }

  @media (max-width: 480px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
