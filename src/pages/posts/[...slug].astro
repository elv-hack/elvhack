---
import { render } from 'astro:content';

import Callout from '@/components/mdx/Callout.astro';
import Experiment from '@/components/mdx/Experiment.astro';
import SignalScope from '@/components/mdx/SignalScope.astro';
import PostLayout from '@/layouts/PostLayout.astro';
import { getPosts, type Post } from '@/lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, prev: posts[i + 1], next: posts[i - 1] },
  }));
}

interface Props {
  post: Post;
  prev?: Post;
  next?: Post;
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
---

<PostLayout post={post} headings={headings} prev={prev} next={next}>
  <Content components={{ Callout, Experiment, SignalScope }} />
</PostLayout>
