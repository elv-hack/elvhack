---
import { formatDate, postCover, postHref, readingMinutes, type Post } from '@/lib/posts';
import Cover from './Cover.astro';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const { code } = postCover(post);
---

<a href={postHref(post)} class="featured" data-spotlight>
  <Cover post={post} label name={`cover-${post.id}`} class="art" />
  <div class="info">
    <p class="kicker mono"><span class="dot" aria-hidden="true"></span>最新信号 · {code}</p>
    <h3 class="title" transition:name={`title-${post.id}`}>{post.data.title}</h3>
    <p class="desc">{post.data.description}</p>
    <p class="meta mono">
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
      <span>约 {readingMinutes(post.body)} 分钟</span>
      {post.data.tags.length > 0 && <span>{post.data.tags.map((tag) => `#${tag}`).join(' ')}</span>}
    </p>
    <span class="cta mono">阅读全文 <span aria-hidden="true">→</span></span>
  </div>
</a>

<style>
  .featured {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--bg);
    text-decoration: none;
    overflow: clip;
    transition: border-color 0.3s;
  }

  .featured:hover {
    border-color: var(--accent-ink);
  }

  .featured :global(.art) {
    aspect-ratio: 16 / 10;
    border-right: 1px solid var(--line);
  }

  .featured:hover :global(.art svg) {
    transform: scale(1.04);
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: clamp(var(--space-5), 3vw, var(--space-7));
  }

  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    font-size: var(--step--2);
    color: var(--accent-ink);
    text-transform: uppercase;
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--accent) 25%, transparent);
  }

  .title {
    font-size: var(--step-3);
    line-height: 1.2;
  }

  .desc {
    color: var(--fg-muted);
    line-height: 1.7;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em 1.2em;
    font-size: var(--step--2);
    color: var(--fg-muted);
  }

  .cta {
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
  }

  .cta span {
    display: inline-block;
    transition: transform 0.3s var(--ease-out);
  }

  .featured:hover .cta span {
    transform: translateX(6px);
  }

  @media (max-width: 860px) {
    .featured {
      grid-template-columns: 1fr;
    }

    .featured :global(.art) {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
  }
</style>
