---
/**
 * 首页背景：Perlin 噪声驱动的粒子流场，指针附近会形成涡旋。
 * 颜色读取 CSS 变量，随明暗主题切换；减少动态效果时只渲染一帧静态图。
 */
---

<field-canvas>
  <canvas aria-hidden="true"></canvas>
  <p class="readout mono" aria-hidden="true">
    <span data-out="stats">0 particles</span>
  </p>
</field-canvas>

<style>
  field-canvas {
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
  }

  canvas {
    width: 100%;
    height: 100%;
  }

  .readout {
    position: absolute;
    right: calc(var(--gutter) * 0.5 + 24px);
    bottom: calc(var(--space-5) + 22px);
    display: flex;
    flex-direction: column;
    align-items: end;
    gap: 0.2em;
    font-size: var(--step--2);
    color: var(--fg-faint);
    pointer-events: none;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 640px) {
    .readout {
      display: none;
    }
  }
</style>

<script>
  import { FlowField } from '@/scripts/flow-field';
  import { Loop } from '@/scripts/loop';
  import { prefersReducedMotion, themeColors } from '@/scripts/theme';

  class FieldCanvas extends HTMLElement {
    #field!: FlowField;
    #loop!: Loop;
    #stats!: HTMLElement;
    #reduce = false;
    #fps = { frames: 0, since: 0 };
    #resizeObserver?: ResizeObserver;
    #host: HTMLElement | null = null;

    connectedCallback() {
      this.#field = new FlowField(this.querySelector('canvas')!);
      this.#stats = this.querySelector('[data-out="stats"]')!;
      this.#reduce = prefersReducedMotion();
      this.#readColors();

      this.#loop = new Loop(this, (now) => {
        this.#field.step();
        this.#tickFps(now);
      });
      this.#loop.paused = this.#reduce;

      this.#resizeObserver = new ResizeObserver(() => this.#resize());
      this.#resizeObserver.observe(this);
      this.#loop.start();

      this.#host = this.parentElement;
      this.#host?.addEventListener('pointermove', this.#onPointer);
      this.#host?.addEventListener('pointerleave', this.#onLeave);
      document.addEventListener('themechange', this.#onTheme);
    }

    disconnectedCallback() {
      this.#loop.stop();
      this.#resizeObserver?.disconnect();
      this.#host?.removeEventListener('pointermove', this.#onPointer);
      this.#host?.removeEventListener('pointerleave', this.#onLeave);
      document.removeEventListener('themechange', this.#onTheme);
    }

    #readColors() {
      const { bg, fg, accent } = themeColors();
      this.#field.colors = { bg, ink: fg, accent };
    }

    #onTheme = () => {
      this.#readColors();
      this.#field.clear();
      if (this.#reduce) this.#field.renderStatic();
    };

    #onPointer = (event: PointerEvent) => {
      const rect = this.getBoundingClientRect();
      this.#field.setPointer(event.clientX - rect.left, event.clientY - rect.top);
    };

    #onLeave = () => this.#field.releasePointer();

    #resize() {
      const rect = this.getBoundingClientRect();
      this.#field.resize(rect.width, rect.height);
      this.#stats.textContent = `${this.#field.count} particles`;
      if (this.#reduce) this.#field.renderStatic();
    }

    #tickFps(now: number) {
      const fps = this.#fps;
      fps.frames += 1;
      if (now - fps.since > 500) {
        const value = Math.round((fps.frames * 1000) / (now - fps.since));
        fps.frames = 0;
        fps.since = now;
        this.#stats.textContent = `${this.#field.count} particles · ${value} fps`;
      }
    }
  }

  if (!customElements.get('field-canvas')) customElements.define('field-canvas', FieldCanvas);
</script>
