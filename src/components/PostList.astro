---
import { formatDate, postHref, type Post } from '@/lib/posts';
import ScrambleText from './ScrambleText.astro';

export interface Props {
  posts: Post[];
  /** 序号从几开始，用于分组列表连续编号 */
  start?: number;
  /** 首页上让标题参与页面切换的形变动画 */
  morph?: boolean;
}

const { posts, start = 1, morph = true } = Astro.props;
---

<ol class="post-list" start={start}>
  {
    posts.map((post, i) => (
      <li>
        <a href={postHref(post)} class="row">
          <span class="idx mono" aria-hidden="true">
            {String(start + i).padStart(2, '0')}
          </span>
          <span class="body">
            <span class="title" transition:name={morph ? `title-${post.id}` : undefined}>
              <ScrambleText text={post.data.title} />
            </span>
            <span class="desc">{post.data.description}</span>
          </span>
          <span class="meta mono">
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
            {post.data.tags.length > 0 && <span class="tags">{post.data.tags.map((tag) => `#${tag}`).join(' ')}</span>}
          </span>
          <span class="arrow" aria-hidden="true">
            →
          </span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .post-list {
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  li {
    border-bottom: 1px solid var(--line);
  }

  .row {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 3.2rem 1fr auto 2rem;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-3);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  /* 悬停时荧光色从左侧扫入 */
  .row::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s var(--ease-out);
  }

  .row:hover,
  .row:focus-visible {
    color: var(--on-accent);
  }

  .row:hover::before,
  .row:focus-visible::before {
    transform: scaleX(1);
  }

  .row:hover :is(.idx, .desc, .meta),
  .row:focus-visible :is(.idx, .desc, .meta) {
    color: var(--on-accent);
  }

  .idx {
    font-size: var(--step--1);
    color: var(--accent-ink);
    transition: color 0.2s;
  }

  .body {
    display: grid;
    gap: var(--space-1);
    min-width: 0;
  }

  .title {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .desc {
    color: var(--fg-muted);
    font-size: var(--step--1);
    line-height: 1.6;
    transition: color 0.2s;
  }

  .meta {
    display: grid;
    justify-items: end;
    gap: 0.2em;
    font-size: var(--step--2);
    color: var(--fg-muted);
    white-space: nowrap;
    transition: color 0.2s;
  }

  .arrow {
    justify-self: end;
    font-size: var(--step-1);
    transform: translateX(-6px);
    opacity: 0;
    transition:
      transform 0.3s var(--ease-out),
      opacity 0.3s;
  }

  .row:hover .arrow,
  .row:focus-visible .arrow {
    transform: none;
    opacity: 1;
  }

  @media (max-width: 720px) {
    .row {
      grid-template-columns: 2.2rem 1fr;
      gap: var(--space-2) var(--space-3);
      padding-inline: var(--space-2);
    }

    .meta {
      grid-column: 2;
      grid-auto-flow: column;
      justify-content: start;
      gap: var(--space-4);
    }

    .arrow {
      display: none;
    }
  }
</style>
