{
  "$schema": "https://unpkg.com/wrangler@4.146.0/config-schema.json",
  // www 子域名跳转到主域名。部署：在本目录运行 npx wrangler@4.146.0 deploy
  // 绑定为自定义域名后，Cloudflare 会自动创建 www 的 DNS 记录和证书。
  "name": "elvhack-www-redirect",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "www.elvhack.com", "custom_domain": true }]
}
