---
/** EXP-03 山脊线：动态的《Unknown Pleasures》 */
---

<ridge-lab class="lab-stage">
  <canvas aria-label="动态山脊线，峰值随指针左右移动" role="img"></canvas>
  <details class="lab-panel" open>
    <summary>参数 / controls</summary>
    <div class="controls">
      <label class="lab-control">线条 <output data-for="lines">36</output>
        <input name="lines" type="range" min="8" max="80" step="1" value="36" />
      </label>
      <label class="lab-control">振幅 <output data-for="amp">1.00</output>
        <input name="amp" type="range" min="0" max="2.5" step="0.05" value="1" />
      </label>
      <label class="lab-control">峰宽 <output data-for="spread">1.00</output>
        <input name="spread" type="range" min="0.3" max="2.5" step="0.05" value="1" />
      </label>
      <label class="lab-control">速度 <output data-for="speed">0.60</output>
        <input name="speed" type="range" min="0" max="3" step="0.05" value="0.6" />
      </label>
      <div class="lab-buttons">
        <button type="button" data-action="pause" aria-pressed="false">暂停</button>
      </div>
    </div>
  </details>
</ridge-lab>

<script>
  import { bindPanel } from '@/scripts/lab-panel';
  import { Loop } from '@/scripts/loop';
  import { noise3 } from '@/scripts/noise';
  import { prefersReducedMotion, themeColors } from '@/scripts/theme';

  class RidgeLab extends HTMLElement {
    #ctx!: CanvasRenderingContext2D;
    #canvas!: HTMLCanvasElement;
    #loop!: Loop;
    #resize?: ResizeObserver;
    #cleanup: (() => void)[] = [];
    #state = { lines: 36, amp: 1, spread: 1, speed: 0.6 };
    #w = 1;
    #h = 1;
    #dpr = 1;
    #t = 0;
    #center = 0.5;
    #target = 0.5;
    #colors = themeColors();

    connectedCallback() {
      this.#canvas = this.querySelector('canvas')!;
      this.#ctx = this.#canvas.getContext('2d')!;
      this.#loop = new Loop(this, () => {
        this.#t += 0.01 * this.#state.speed;
        this.#center += (this.#target - this.#center) * 0.06;
        this.#draw();
      });

      const panel = bindPanel(
        this,
        {
          lines: (v) => (this.#state.lines = v),
          amp: (v) => (this.#state.amp = v),
          spread: (v) => (this.#state.spread = v),
          speed: (v) => (this.#state.speed = v),
        },
        { fixed: { amp: 2, spread: 2, speed: 2 } },
      );
      panel.on('pause', (button) => {
        this.#loop.paused = !this.#loop.paused;
        button.setAttribute('aria-pressed', String(this.#loop.paused));
        button.textContent = this.#loop.paused ? '播放' : '暂停';
      });

      this.#resize = new ResizeObserver(() => {
        const rect = this.getBoundingClientRect();
        this.#dpr = Math.min(devicePixelRatio || 1, 2);
        this.#w = Math.round(rect.width * this.#dpr);
        this.#h = Math.round(rect.height * this.#dpr);
        this.#canvas.width = this.#w;
        this.#canvas.height = this.#h;
        this.#draw();
      });
      this.#resize.observe(this);

      const onMove = (event: PointerEvent) => {
        const rect = this.getBoundingClientRect();
        this.#target = (event.clientX - rect.left) / rect.width;
      };
      const onLeave = () => (this.#target = 0.5);
      const onTheme = () => {
        this.#colors = themeColors();
        this.#draw();
      };
      const onInput = () => this.#loop.paused && this.#draw();
      this.#canvas.addEventListener('pointermove', onMove);
      this.#canvas.addEventListener('pointerleave', onLeave);
      this.addEventListener('input', onInput);
      document.addEventListener('themechange', onTheme);
      this.#cleanup.push(
        () => this.#canvas.removeEventListener('pointermove', onMove),
        () => this.#canvas.removeEventListener('pointerleave', onLeave),
        () => this.removeEventListener('input', onInput),
        () => document.removeEventListener('themechange', onTheme),
      );

      if (prefersReducedMotion()) this.#loop.paused = true;
      this.#loop.start();
    }

    disconnectedCallback() {
      this.#loop.stop();
      this.#resize?.disconnect();
      for (const fn of this.#cleanup) fn();
    }

    #draw() {
      const ctx = this.#ctx;
      const { lines, amp, spread } = this.#state;
      const w = this.#w;
      const h = this.#h;
      const d = this.#dpr;
      // 画面居中的一块“唱片封面”区域
      const width = Math.min(w * 0.82, h * 1.1);
      const left = (w - width) / 2;
      const top = h * 0.24;
      const bottom = h * 0.86;
      const gap = (bottom - top) / lines;
      const points = Math.max(60, Math.round(width / (6 * d)));
      const cx = left + width * this.#center;
      const sigma = width * 0.09 * spread;
      const accentLine = Math.floor(lines * 0.58);

      ctx.fillStyle = this.#colors.bg;
      ctx.fillRect(0, 0, w, h);
      ctx.lineJoin = 'round';

      for (let li = 0; li < lines; li++) {
        const y0 = top + li * gap;
        const room = y0 - h * 0.04;
        const line = new Path2D();
        for (let pi = 0; pi <= points; pi++) {
          const x = left + (pi / points) * width;
          const env =
            Math.exp(-(((x - cx) / sigma) ** 2)) +
            0.55 * Math.exp(-(((x - cx - sigma * 1.4) / (sigma * 0.7)) ** 2)) +
            0.4 * Math.exp(-(((x - cx + sigma * 1.6) / (sigma * 0.8)) ** 2));
          const n = noise3((x / width) * 7, li * 0.32, this.#t);
          const raw = env * amp * (gap * 1.8 + Math.abs(n) * gap * 9) + n * gap * 0.3;
          // tanh 软限幅，峰值不会冲出画面
          const y = y0 - room * Math.tanh(raw / room);
          if (pi === 0) line.moveTo(x, y);
          else line.lineTo(x, y);
        }
        // 先用背景色填充线下方区域遮住后排，再描线
        const shade = new Path2D(line);
        shade.lineTo(left + width, h);
        shade.lineTo(left, h);
        shade.closePath();
        ctx.fillStyle = this.#colors.bg;
        ctx.fill(shade);

        const accent = li === accentLine;
        ctx.strokeStyle = accent ? this.#colors.accent : this.#colors.fg;
        ctx.globalAlpha = accent ? 1 : 0.85;
        ctx.lineWidth = (accent ? 2.2 : 1.3) * d;
        ctx.stroke(line);
        ctx.globalAlpha = 1;
      }
    }
  }

  if (!customElements.get('ridge-lab')) customElements.define('ridge-lab', RidgeLab);
</script>
