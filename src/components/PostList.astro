---
import { COVER_H, COVER_W } from '@/lib/generative';
import { formatDate, postCover, postHref, type Post } from '@/lib/posts';
import ScrambleText from './ScrambleText.astro';

export interface Props {
  posts: Post[];
  /** 序号从几开始，用于分组列表连续编号 */
  start?: number;
  /** 首页上让标题参与页面切换的形变动画 */
  morph?: boolean;
}

const { posts, start = 1, morph = true } = Astro.props;
---

<post-list>
<ol class="post-list" start={start}>
  {
    posts.map((post, i) => (
      <li>
        <a href={postHref(post)} class="row" data-cover={`${postCover(post).file}#art`} data-code={postCover(post).code}>
          <span class="idx mono" aria-hidden="true">
            {String(start + i).padStart(2, '0')}
          </span>
          <span class="body">
            <span class="title" transition:name={morph ? `title-${post.id}` : undefined}>
              <ScrambleText text={post.data.title} />
            </span>
            <span class="desc">{post.data.description}</span>
          </span>
          <span class="meta mono">
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
            {post.data.tags.length > 0 && <span class="tags">{post.data.tags.map((tag) => `#${tag}`).join(' ')}</span>}
          </span>
          <span class="arrow" aria-hidden="true">
            →
          </span>
        </a>
      </li>
    ))
  }
</ol>
<div class="peek" aria-hidden="true">
  <svg viewBox={`0 0 ${COVER_W} ${COVER_H}`} preserveAspectRatio="xMidYMid slice"><use></use></svg>
  <span class="peek-code mono"></span>
</div>
</post-list>

<style>
  post-list {
    position: relative;
    display: block;
  }

  /* 悬停预览：封面跟随指针浮出 */
  .peek {
    --cover-accent: var(--accent-ink);
    --cover-bg: var(--bg-elev);
    position: fixed;
    top: 0;
    left: 0;
    z-index: 40;
    width: 280px;
    aspect-ratio: 16 / 10;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--cover-bg);
    color: var(--fg);
    box-shadow: 0 24px 60px -20px rgb(0 0 0 / 0.45);
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    scale: 0.85;
    transition:
      opacity 0.25s ease,
      scale 0.35s var(--ease-out);
  }

  .peek[data-show] {
    opacity: 1;
    scale: 1;
  }

  .peek svg {
    width: 100%;
    height: 100%;
  }

  .peek-code {
    position: absolute;
    left: 0.7em;
    bottom: 0.5em;
    font-size: var(--step--2);
    color: var(--fg-muted);
  }

  .post-list {
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  li {
    border-bottom: 1px solid var(--line);
  }

  .row {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 3.2rem 1fr auto 2rem;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-3);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  /* 悬停时荧光色从左侧扫入 */
  .row::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s var(--ease-out);
  }

  .row:hover,
  .row:focus-visible {
    color: var(--on-accent);
  }

  .row:hover::before,
  .row:focus-visible::before {
    transform: scaleX(1);
  }

  .row:hover :is(.idx, .desc, .meta),
  .row:focus-visible :is(.idx, .desc, .meta) {
    color: var(--on-accent);
  }

  .idx {
    font-size: var(--step--1);
    color: var(--accent-ink);
    transition: color 0.2s;
  }

  .body {
    display: grid;
    gap: var(--space-1);
    min-width: 0;
  }

  .title {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .desc {
    color: var(--fg-muted);
    font-size: var(--step--1);
    line-height: 1.6;
    transition: color 0.2s;
  }

  .meta {
    display: grid;
    justify-items: end;
    gap: 0.2em;
    font-size: var(--step--2);
    color: var(--fg-muted);
    white-space: nowrap;
    transition: color 0.2s;
  }

  .arrow {
    justify-self: end;
    font-size: var(--step-1);
    transform: translateX(-6px);
    opacity: 0;
    transition:
      transform 0.3s var(--ease-out),
      opacity 0.3s;
  }

  .row:hover .arrow,
  .row:focus-visible .arrow {
    transform: none;
    opacity: 1;
  }

  @media (max-width: 720px) {
    .row {
      grid-template-columns: 2.2rem 1fr;
      gap: var(--space-2) var(--space-3);
      padding-inline: var(--space-2);
    }

    .meta {
      grid-column: 2;
      grid-auto-flow: column;
      justify-content: start;
      gap: var(--space-4);
    }

    .arrow {
      display: none;
    }
  }
</style>

<script>
  class PostList extends HTMLElement {
    #peek!: HTMLElement;
    #use!: SVGUseElement;
    #code!: HTMLElement;
    #frame = 0;
    #target = { x: 0, y: 0 };
    #pos = { x: 0, y: 0 };
    #active = false;

    connectedCallback() {
      const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!fine || reduce) return;
      this.#peek = this.querySelector('.peek')!;
      this.#use = this.querySelector('.peek use')!;
      this.#code = this.querySelector('.peek-code')!;
      this.addEventListener('pointerover', this.#onOver);
      this.addEventListener('pointermove', this.#onMove);
      this.addEventListener('pointerleave', this.#onLeave);
    }

    disconnectedCallback() {
      cancelAnimationFrame(this.#frame);
      this.removeEventListener('pointerover', this.#onOver);
      this.removeEventListener('pointermove', this.#onMove);
      this.removeEventListener('pointerleave', this.#onLeave);
    }

    #onOver = (event: PointerEvent) => {
      const row = (event.target as Element).closest<HTMLElement>('.row');
      if (!row) return;
      if (this.#use.getAttribute('href') !== row.dataset.cover) {
        this.#use.setAttribute('href', row.dataset.cover!);
        this.#code.textContent = row.dataset.code ?? '';
      }
      if (!this.#active) {
        this.#pos = { x: event.clientX, y: event.clientY };
        this.#active = true;
        this.#loop();
      }
      this.#peek.toggleAttribute('data-show', true);
    };

    #onMove = (event: PointerEvent) => {
      this.#target = { x: event.clientX, y: event.clientY };
    };

    #onLeave = () => {
      this.#peek.removeAttribute('data-show');
      this.#active = false;
    };

    #loop = () => {
      // 缓动跟随，预览在指针右侧，靠近视口右缘时翻到左侧
      this.#pos.x += (this.#target.x - this.#pos.x) * 0.18;
      this.#pos.y += (this.#target.y - this.#pos.y) * 0.18;
      const width = this.#peek.offsetWidth;
      const height = this.#peek.offsetHeight;
      const flip = this.#pos.x + width + 40 > innerWidth;
      const x = flip ? this.#pos.x - width - 28 : this.#pos.x + 28;
      const y = Math.min(Math.max(this.#pos.y - height / 2, 72), innerHeight - height - 12);
      this.#peek.style.transform = `translate(${x}px, ${y}px)`;
      if (this.#active) this.#frame = requestAnimationFrame(this.#loop);
    };
  }

  if (!customElements.get('post-list')) customElements.define('post-list', PostList);
</script>
