---
import FeaturedPost from '@/components/FeaturedPost.astro';
import HeroField from '@/components/HeroField.astro';
import HeroHud from '@/components/HeroHud.astro';
import LabGrid from '@/components/LabGrid.astro';
import Marquee from '@/components/Marquee.astro';
import PostList from '@/components/PostList.astro';
import StatusPanel from '@/components/StatusPanel.astro';
import TagCloud from '@/components/TagCloud.astro';
import Wordmark from '@/components/Wordmark.astro';
import { labs } from '@/lab/registry';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPosts, getTags } from '@/lib/posts';
import { site } from '@/site.config';

const posts = await getPosts();
const [featured, ...rest] = posts;
const more = rest.slice(0, 6);
const tags = getTags(posts);
---

<BaseLayout>
  <section class="hero" aria-labelledby="hero-title">
    <HeroField />
    <HeroHud />
    <div class="container hero-inner">
      <p class="kicker mono">[ signal / noise ] — 个人实验室</p>
      <h1 id="hero-title" class="wordmark"><Wordmark text="ELVHACK" /></h1>
      <p class="tagline">{site.tagline}<br />写下做过的东西，留下能玩的实验。</p>
      <a href="#latest" class="scroll mono">↓ 最近的信号</a>
    </div>
  </section>

  <Marquee />

  <section id="latest" class="container block">
    <h2 class="section-head">
      <span><span class="num">[01]</span> 最新</span>
      {posts.length > 1 && <a href="/posts/">全部 {posts.length} 篇 →</a>}
    </h2>
    {featured ? <FeaturedPost post={featured} /> : <p class="empty">还没有文章。信号正在路上。</p>}
    {more.length > 0 && <PostList posts={more} start={2} />}
  </section>

  <section class="container block">
    <h2 class="section-head">
      <span><span class="num">[02]</span> 实验室</span>
      <a href="/lab/">全部实验 →</a>
    </h2>
    <LabGrid entries={labs.slice(0, 4)} compact />
  </section>

  {
    tags.length > 0 && (
      <section class="container block">
        <h2 class="section-head">
          <span>
            <span class="num">[03]</span> 标签
          </span>
          <a href="/tags/">全部标签 →</a>
        </h2>
        <TagCloud tags={tags} />
      </section>
    )
  }

  <section class="container block">
    <h2 class="section-head">
      <span><span class="num">[04]</span> 状态</span>
      <a href="/about/">关于本站 →</a>
    </h2>
    <StatusPanel posts={posts} />
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: end;
    min-height: max(600px, 100svh);
    margin-top: calc(var(--header-h) * -1);
    padding-block: calc(var(--header-h) + var(--space-7)) var(--space-8);
    cursor: crosshair;
  }

  /* 顶部渐隐，保证导航在背景之上清晰可读 */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    z-index: 1;
    height: calc(var(--header-h) + 80px);
    background: linear-gradient(to bottom, var(--bg) 35%, transparent);
    pointer-events: none;
  }

  /* 底部渐隐进页面背景 */
  .hero::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 30%;
    background: linear-gradient(to bottom, transparent, var(--bg));
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    pointer-events: none;
  }

  .hero-inner a {
    pointer-events: auto;
    cursor: pointer;
  }

  .kicker {
    font-size: var(--step--1);
    color: var(--accent-ink);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .wordmark {
    font-family: var(--font-display);
    margin-top: var(--space-3);
    margin-left: -0.05em;
    font-size: var(--step-hero);
    font-weight: 700;
    line-height: 0.86;
    letter-spacing: -0.055em;
    white-space: nowrap;
  }

  .tagline {
    margin-top: var(--space-6);
    max-width: 30em;
    font-size: var(--step-1);
    line-height: 1.6;
    color: var(--fg-muted);
  }

  .scroll {
    display: inline-block;
    margin-top: var(--space-7);
    font-size: var(--step--1);
    color: var(--fg-muted);
    text-decoration: none;
    animation: bob 2.4s ease-in-out infinite;
  }

  .scroll:hover {
    color: var(--accent-ink);
  }

  @keyframes bob {
    50% {
      transform: translateY(4px);
    }
  }

  .block {
    margin-top: var(--space-9);
  }

  #latest {
    margin-top: var(--space-8);
  }

  #latest :global(post-list) {
    margin-top: var(--space-6);
  }

  .empty {
    color: var(--fg-muted);
  }
</style>
