---
import type { MarkdownHeading } from 'astro';
import '@/styles/prose.css';

import ReadingBackdrop from '@/components/ReadingBackdrop.astro';
import Cover from '@/components/Cover.astro';
import Giscus from '@/components/Giscus.astro';
import RelatedPosts from '@/components/RelatedPosts.astro';
import Toc from '@/components/Toc.astro';
import { formatDate, postCover, postHref, readingMinutes, tagHref, type Post } from '@/lib/posts';
import BaseLayout from './BaseLayout.astro';

export interface Props {
  post: Post;
  headings: MarkdownHeading[];
  prev?: Post;
  next?: Post;
  related?: Post[];
}

const { post, headings, prev, next, related = [] } = Astro.props;
const { title, description, pubDate, updatedDate, tags } = post.data;
const minutes = readingMinutes(post.body);
const { code, style } = postCover(post);
---

<BaseLayout
  title={title}
  description={description}
  image={`/og/${post.id.replaceAll('/', '--')}.png`}
  article={{ published: pubDate, modified: updatedDate, tags }}
  fontText={title}
>
  <ReadingBackdrop slot="backdrop" />
  <div class="progress" aria-hidden="true"></div>

  <article class="container post">
    <header class="post-head">
      <Cover post={post} name={`cover-${post.id}`} class="head-art" />
      <a href="/posts/" class="back mono">← 全部文章</a>
      {
        tags.length > 0 && (
          <ul class="tags mono">
            {tags.map((tag) => (
              <li>
                <a href={tagHref(tag)}>#{tag}</a>
              </li>
            ))}
          </ul>
        )
      }
      <h1 transition:name={`title-${post.id}`} data-pagefind-meta="title">{title}</h1>
      <span hidden data-pagefind-meta="type:文章"></span>
      <p class="lede">{description}</p>
      <dl class="meta mono">
        <div>
          <dt>发布</dt>
          <dd><time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time></dd>
        </div>
        {
          updatedDate && (
            <div>
              <dt>更新</dt>
              <dd>
                <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
              </dd>
            </div>
          )
        }
        <div>
          <dt>阅读</dt>
          <dd>约 {minutes} 分钟</dd>
        </div>
        <div>
          <dt>信号</dt>
          <dd>{code} · {style}</dd>
        </div>
      </dl>
    </header>

    <div class="layout">
      <aside class="side">
        <Toc headings={headings} />
      </aside>

      <post-body class="prose" data-pagefind-body>
        <slot />
      </post-body>

      <aside class="notes-rail" aria-hidden="true"></aside>
    </div>

    <footer class="post-foot">
      {
        (prev || next) && (
          <nav class="pager" aria-label="相邻文章">
            {prev ? (
              <a href={postHref(prev)} rel="prev" class="older" data-spotlight>
                <span class="mono">← 更早</span>
                <span class="t">{prev.data.title}</span>
              </a>
            ) : (
              <span />
            )}
            {next && (
              <a href={postHref(next)} rel="next" class="newer" data-spotlight>
                <span class="mono">更新 →</span>
                <span class="t">{next.data.title}</span>
              </a>
            )}
          </nav>
        )
      }
      <RelatedPosts posts={related} />
      <Giscus />
    </footer>
  </article>
</BaseLayout>

<style>
  .progress {
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
    height: 2px;
    background: var(--accent);
    transform-origin: left;
    transform: scaleX(0);
    display: none;
  }

  @supports (animation-timeline: scroll()) {
    .progress {
      display: block;
      animation: grow linear both;
      animation-timeline: scroll(root);
    }
  }

  @keyframes grow {
    to {
      transform: scaleX(1);
    }
  }

  .post-head {
    position: relative;
    padding-block: var(--space-8) var(--space-7);
  }

  .post-head > :not(.head-art) {
    position: relative;
    z-index: 1;
    max-width: 52rem;
  }

  /* 文章的生成封面作为标题区背景，向左、向下淡出 */
  .post-head :global(.head-art) {
    --cover-bg: var(--bg);
    position: absolute;
    top: var(--space-5);
    right: 0;
    width: min(52%, 680px);
    aspect-ratio: 16 / 10;
    background: transparent;
    opacity: 0.9;
    mask-image: linear-gradient(to right, transparent, #000 55%), linear-gradient(to bottom, #000 55%, transparent);
    mask-composite: intersect;
  }

  @media (max-width: 860px) {
    .post-head :global(.head-art) {
      top: 0;
      width: 100%;
      opacity: 0.35;
    }
  }

  .back {
    display: inline-block;
    margin-bottom: var(--space-6);
    font-size: var(--step--1);
    color: var(--fg-muted);
    text-decoration: none;
  }

  .back:hover {
    color: var(--accent-ink);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
    padding: 0;
    list-style: none;
    font-size: var(--step--1);
  }

  .tags a {
    color: var(--accent-ink);
    text-decoration: none;
  }

  .tags a:hover {
    text-decoration: underline;
  }

  h1 {
    font-size: var(--step-4);
    line-height: 1.15;
  }

  .post-head > .lede {
    margin-top: var(--space-5);
    max-width: 30em;
    font-size: var(--step-1);
    color: var(--fg-muted);
    line-height: 1.6;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
  }

  .meta div {
    display: flex;
    gap: 0.6em;
  }

  dt {
    color: var(--fg-faint);
  }

  .post {
    --toc-w: 12rem;
    --note-w: 14rem;
    --col-gap: clamp(2rem, 3.5vw, 4rem);
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, var(--measure));
    gap: var(--space-8);
  }

  .side,
  .notes-rail {
    display: none;
  }

  @media (min-width: 1100px) {
    .layout {
      grid-template-columns: minmax(0, var(--measure)) 15rem;
      justify-content: space-between;
    }

    .side {
      display: block;
      grid-column: 2;
      grid-row: 1;
    }

    .side :global(toc-nav) {
      position: sticky;
      top: calc(var(--header-h) + var(--space-6));
    }
  }

  /* 宽屏三栏：左目录 · 正文 · 右旁注，标题区与正文对齐 */
  @media (min-width: 1280px) {
    .layout {
      grid-template-columns: var(--toc-w) minmax(0, var(--measure)) var(--note-w);
      justify-content: start;
      column-gap: var(--col-gap);
    }

    .side {
      grid-column: 1;
    }

    post-body {
      grid-column: 2;
      grid-row: 1;
    }

    .notes-rail {
      display: block;
      position: relative;
      grid-column: 3;
      grid-row: 1;
    }

    .post-head > :not(.head-art),
    .post-foot {
      margin-left: calc(var(--toc-w) + var(--col-gap));
    }
  }

  post-body {
    position: relative;
    display: block;
    min-width: 0;
  }

  .post-foot {
    max-width: var(--measure);
    margin-top: var(--space-8);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  .pager a {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
    transition:
      border-color 0.15s,
      background-color 0.15s;
  }

  .pager a:hover {
    border-color: var(--accent-ink);
    background: var(--bg-elev);
  }

  .pager .mono {
    font-size: var(--step--2);
    color: var(--fg-muted);
  }

  .pager .t {
    font-family: var(--font-serif);
    font-weight: 600;
    line-height: 1.35;
  }

  .newer {
    grid-column: 2;
    text-align: right;
  }

  @media (max-width: 560px) {
    .pager {
      grid-template-columns: 1fr;
    }

    .newer {
      grid-column: 1;
    }
  }
</style>

<script>
  const reduceMotion = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
  const EASE = 'cubic-bezier(0.2, 0.7, 0.2, 1)';

  /** 点击正文图片放大：从原位置平滑放大到屏幕中央（FLIP） */
  function openLightbox(img: HTMLImageElement) {
    const dialog = document.createElement('dialog');
    dialog.className = 'lightbox';
    const big = document.createElement('img');
    big.src = img.currentSrc || img.src;
    big.alt = img.alt;
    dialog.append(big);
    const caption = img.closest('figure')?.querySelector('figcaption')?.textContent;
    if (caption) {
      const cap = document.createElement('p');
      cap.className = 'lightbox-caption';
      cap.textContent = caption;
      dialog.append(cap);
    }
    document.body.append(dialog);
    dialog.showModal();

    const flip = () => {
      const from = img.getBoundingClientRect();
      const to = big.getBoundingClientRect();
      const scale = from.width / to.width;
      const dx = from.left + from.width / 2 - (to.left + to.width / 2);
      const dy = from.top + from.height / 2 - (to.top + to.height / 2);
      return `translate(${dx}px, ${dy}px) scale(${scale})`;
    };

    if (!reduceMotion()) {
      big.animate([{ transform: flip() }, { transform: 'none' }], { duration: 420, easing: EASE });
      dialog.animate([{ backgroundColor: 'transparent' }, {}], { duration: 300 });
    }

    let closing = false;
    const close = () => {
      if (closing) return;
      closing = true;
      if (reduceMotion()) {
        dialog.close();
        dialog.remove();
        return;
      }
      const fade = dialog.animate([{}, { backgroundColor: 'transparent' }], { duration: 280, fill: 'forwards' });
      big.animate([{ transform: 'none' }, { transform: flip() }], { duration: 320, easing: EASE, fill: 'forwards' });
      fade.finished.then(() => {
        dialog.close();
        dialog.remove();
      });
    };
    dialog.addEventListener('click', close);
    dialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      close();
    });
  }

  /** 正文增强：标题锚点、图注、灯箱、代码块标题栏与复制、宽屏旁注、窄屏脚注弹出层 */
  class PostBody extends HTMLElement {
    #notes: { ref: HTMLAnchorElement; note: HTMLElement }[] = [];
    #rail: HTMLElement | null = null;
    #observer?: ResizeObserver;
    #pop: HTMLElement | null = null;
    #popRef: HTMLAnchorElement | null = null;
    #abort?: AbortController;

    connectedCallback() {
      this.#anchors();
      this.#figures();
      this.#codeBlocks();
      this.#sidenotes();
    }

    disconnectedCallback() {
      this.#observer?.disconnect();
      this.#abort?.abort();
    }

    #anchors() {
      for (const heading of this.querySelectorAll<HTMLElement>(':is(h2, h3, h4)[id]:not(.sr-only)')) {
        if (heading.querySelector('.anchor')) continue;
        const anchor = document.createElement('a');
        anchor.className = 'anchor';
        anchor.href = `#${heading.id}`;
        anchor.textContent = '#';
        anchor.setAttribute('aria-label', `链接到「${heading.textContent}」`);
        heading.append(anchor);
      }
    }

    #figures() {
      let count = 0;
      for (const img of this.querySelectorAll<HTMLImageElement>('img')) {
        if (img.closest('a, .experiment, .lightbox')) continue;
        const paragraph = img.parentElement;
        const title = img.getAttribute('title');
        // 段落里只有这一张带标题的图：转成带编号图注的 figure
        if (title && paragraph?.tagName === 'P' && paragraph.textContent?.trim() === '' && paragraph.children.length === 1) {
          count += 1;
          const figure = document.createElement('figure');
          figure.className = 'figure';
          const caption = document.createElement('figcaption');
          const label = document.createElement('span');
          label.className = 'mono';
          label.textContent = `图 ${String(count).padStart(2, '0')}`;
          caption.append(label, ` ${title}`);
          img.removeAttribute('title');
          paragraph.replaceWith(figure);
          figure.append(img, caption);
        }
        img.classList.add('zoomable');
        img.addEventListener('click', () => openLightbox(img));
      }
    }

    #codeBlocks() {
      for (const pre of this.querySelectorAll<HTMLPreElement>('pre')) {
        if (pre.parentElement?.classList.contains('code-block')) continue;
        const wrap = document.createElement('div');
        wrap.className = 'code-block';
        pre.replaceWith(wrap);
        wrap.append(pre);

        const tools = document.createElement('div');
        tools.className = 'code-tools';
        const title = pre.dataset.title;
        if (title) {
          wrap.classList.add('has-title');
          const name = document.createElement('span');
          name.className = 'code-title';
          name.textContent = title;
          tools.append(name);
        }
        const lang = pre.dataset.language;
        if (lang && lang !== 'plaintext') {
          const label = document.createElement('span');
          label.className = 'code-lang';
          label.textContent = lang;
          tools.append(label);
        }
        if (navigator.clipboard) {
          const button = document.createElement('button');
          button.type = 'button';
          button.textContent = 'copy';
          button.addEventListener('click', async () => {
            try {
              // diff 中被删除的行不复制
              const lines = [...pre.querySelectorAll<HTMLElement>('.line')].filter((line) => !line.classList.contains('remove'));
              await navigator.clipboard.writeText(lines.length ? lines.map((line) => line.textContent).join('\n') : pre.innerText);
              button.textContent = 'copied';
              button.toggleAttribute('data-copied', true);
              setTimeout(() => {
                button.textContent = 'copy';
                button.removeAttribute('data-copied');
              }, 1600);
            } catch {
              button.textContent = 'failed';
            }
          });
          tools.append(button);
        }
        if (title) wrap.prepend(tools);
        else wrap.append(tools);
      }
    }

    #sidenotes() {
      this.#rail = this.parentElement?.querySelector<HTMLElement>('.notes-rail') ?? null;
      const refs = [...this.querySelectorAll<HTMLAnchorElement>('a[data-footnote-ref]')];
      if (!this.#rail || refs.length === 0) return;
      this.#rail.replaceChildren();

      for (const ref of refs) {
        const item = document.getElementById(decodeURIComponent(ref.hash.slice(1)));
        if (!item) continue;
        const note = document.createElement('div');
        note.className = 'sidenote';
        const num = document.createElement('span');
        num.className = 'num mono';
        num.textContent = ref.textContent ?? '';
        const body = document.createElement('div');
        body.className = 'body';
        const clone = item.cloneNode(true) as HTMLElement;
        for (const back of clone.querySelectorAll('[data-footnote-backref]')) back.remove();
        body.append(...clone.childNodes);
        note.append(num, body);
        this.#rail.append(note);

        const on = () => {
          note.classList.add('active');
          ref.classList.add('active');
        };
        const off = () => {
          note.classList.remove('active');
          ref.classList.remove('active');
        };
        for (const el of [ref, note]) {
          el.addEventListener('pointerenter', on);
          el.addEventListener('pointerleave', off);
        }
        ref.addEventListener('click', (event) => {
          event.preventDefault();
          if (this.#rail?.offsetParent === null) {
            // 窄屏没有页边：在标号下方就地弹出注释，不跳到文末
            this.#togglePop(ref, body);
            return;
          }
          // 宽屏下点脚注标号不跳到文末，而是让旁注闪一下
          note.classList.remove('flash');
          void note.offsetWidth;
          note.classList.add('flash');
        });
        this.#notes.push({ ref, note });
      }

      this.toggleAttribute('data-sidenotes', true);
      this.#abort = new AbortController();
      const { signal } = this.#abort;
      document.addEventListener(
        'pointerdown',
        (event) => {
          const target = event.target as Element;
          if (this.#pop && !this.#pop.contains(target) && !target.closest?.('a[data-footnote-ref]')) this.#closePop();
        },
        { signal },
      );
      document.addEventListener(
        'keydown',
        (event) => {
          if (event.key !== 'Escape' || !this.#pop) return;
          const ref = this.#popRef;
          this.#closePop();
          ref?.focus();
        },
        { signal },
      );
      let width = innerWidth;
      addEventListener(
        'resize',
        () => {
          if (innerWidth !== width) this.#closePop();
          width = innerWidth;
        },
        { signal },
      );
      this.#layoutNotes();
      this.#observer = new ResizeObserver(() => this.#layoutNotes());
      this.#observer.observe(this);
      document.fonts?.ready.then(() => this.#layoutNotes());
    }

    /** 窄屏脚注：标号下方的小卡片，再点一次标号、点别处或按 Esc 关闭 */
    #togglePop(ref: HTMLAnchorElement, body: HTMLElement) {
      const same = this.#popRef === ref;
      this.#closePop();
      if (same) return;

      const pop = document.createElement('div');
      pop.className = 'note-pop';
      pop.setAttribute('role', 'note');
      pop.setAttribute('aria-label', `注释 ${ref.textContent}`);
      pop.tabIndex = -1;
      const head = document.createElement('div');
      head.className = 'note-pop-head mono';
      const num = document.createElement('span');
      num.textContent = `注 ${ref.textContent}`;
      const jump = document.createElement('a');
      jump.href = ref.hash;
      jump.textContent = '全部注释 ↓';
      jump.addEventListener('click', () => this.#closePop());
      const close = document.createElement('button');
      close.type = 'button';
      close.textContent = '×';
      close.setAttribute('aria-label', '关闭注释');
      close.addEventListener('click', () => {
        this.#closePop();
        ref.focus();
      });
      head.append(num, jump, close);
      const content = document.createElement('div');
      content.className = 'note-pop-body';
      content.append(...(body.cloneNode(true) as HTMLElement).childNodes);
      pop.append(head, content);
      this.append(pop);

      // 放在标号正下方，左右不超出正文栏，小三角对准标号
      const host = this.getBoundingClientRect();
      const rect = ref.getBoundingClientRect();
      const center = rect.left + rect.width / 2 - host.left;
      const left = Math.min(Math.max(center - pop.offsetWidth / 2, 0), host.width - pop.offsetWidth);
      pop.style.top = `${Math.round(rect.bottom - host.top + 10)}px`;
      pop.style.left = `${Math.round(left)}px`;
      pop.style.setProperty('--caret', `${Math.round(center - left)}px`);

      this.#pop = pop;
      this.#popRef = ref;
      ref.classList.add('open');
      ref.setAttribute('aria-expanded', 'true');
      pop.focus({ preventScroll: true });
      const overflow = pop.getBoundingClientRect().bottom - (innerHeight - 16);
      if (overflow > 0) scrollBy({ top: overflow, behavior: reduceMotion() ? 'auto' : 'smooth' });
    }

    #closePop() {
      const pop = this.#pop;
      if (!pop) return;
      this.#popRef?.classList.remove('open');
      this.#popRef?.removeAttribute('aria-expanded');
      this.#pop = null;
      this.#popRef = null;
      if (reduceMotion()) {
        pop.remove();
        return;
      }
      pop.animate([{}, { opacity: 0, transform: 'translateY(-4px)' }], { duration: 120, easing: 'ease-in', fill: 'forwards' }).finished.then(
        () => pop.remove(),
      );
    }

    /** 旁注与正文中的标号对齐，互相不重叠 */
    #layoutNotes() {
      if (!this.#rail || this.#rail.offsetParent === null) return;
      const base = this.#rail.getBoundingClientRect().top;
      let floor = 0;
      for (const { ref, note } of this.#notes) {
        const top = Math.max(ref.getBoundingClientRect().top - base - 3, floor);
        note.style.transform = `translateY(${Math.round(top)}px)`;
        floor = top + note.offsetHeight + 18;
      }
    }
  }

  if (!customElements.get('post-body')) customElements.define('post-body', PostBody);
</script>
