---
import { site } from '@/site.config';

const { repo, repoId, category, categoryId } = site.giscus;
const enabled = Boolean(repoId && categoryId);
---

{
  enabled && (
    <section class="comments" aria-labelledby="comments-title">
      <h2 id="comments-title" class="mono">
        评论 / comments
      </h2>
      <giscus-comments data-repo={repo} data-repo-id={repoId} data-category={category} data-category-id={categoryId} />
    </section>
  )
}

<style>
  .comments {
    margin-top: var(--space-8);
  }

  h2 {
    margin-bottom: var(--space-5);
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  giscus-comments {
    display: block;
    min-height: 200px;
  }
</style>

<script>
  const giscusTheme = () => (document.documentElement.dataset.theme === 'dark' ? 'transparent_dark' : 'light');

  class GiscusComments extends HTMLElement {
    connectedCallback() {
      const script = document.createElement('script');
      const attrs: Record<string, string> = {
        'data-repo': this.dataset.repo!,
        'data-repo-id': this.dataset.repoId!,
        'data-category': this.dataset.category!,
        'data-category-id': this.dataset.categoryId!,
        'data-mapping': 'pathname',
        'data-strict': '1',
        'data-reactions-enabled': '1',
        'data-emit-metadata': '0',
        'data-input-position': 'top',
        'data-theme': giscusTheme(),
        'data-lang': 'zh-CN',
        'data-loading': 'lazy',
      };
      for (const [key, value] of Object.entries(attrs)) script.setAttribute(key, value);
      script.src = 'https://giscus.app/client.js';
      script.crossOrigin = 'anonymous';
      script.async = true;
      this.append(script);
      document.addEventListener('themechange', this.#onTheme);
    }

    disconnectedCallback() {
      document.removeEventListener('themechange', this.#onTheme);
    }

    #onTheme = () => {
      const frame = this.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
      frame?.contentWindow?.postMessage({ giscus: { setConfig: { theme: giscusTheme() } } }, 'https://giscus.app');
    };
  }

  if (!customElements.get('giscus-comments')) customElements.define('giscus-comments', GiscusComments);
</script>
