---
/** EXP-04 双正弦示波器：复用文章里的 SignalScope 组件 */
import SignalScope from '@/components/mdx/SignalScope.astro';
---

<div class="lab-stage scope-stage">
  <div class="scope-wrap">
    <SignalScope f1={3} f2={2} phase={90} />
  </div>
</div>

<style>
  .scope-stage {
    display: grid;
    place-items: center;
    padding: 15rem var(--gutter) var(--space-7);
    background:
      radial-gradient(circle at 50% 40%, color-mix(in oklab, var(--accent) 6%, transparent), transparent 60%),
      var(--bg);
    height: auto;
    min-height: calc(100svh - var(--header-h));
  }

  .scope-wrap {
    width: min(100%, 960px);
    padding: var(--space-5);
    border: 1px solid var(--line-strong);
    border-radius: 6px;
    background: var(--bg-elev);
  }
</style>
