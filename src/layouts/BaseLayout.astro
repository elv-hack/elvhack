---
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource/noto-serif-sc/600.css';
// 只有 Windows 会真正用到（:root.win），其他平台不会下载
import '@fontsource/noto-sans-sc/400.css';
import '@fontsource/noto-sans-sc/700.css';
import '@/styles/global.css';

import BaseHead, { type Props as HeadProps } from '@/components/BaseHead.astro';
import CommandPalette from '@/components/CommandPalette.astro';
import CrtMode from '@/components/CrtMode.astro';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import LinkPreview from '@/components/LinkPreview.astro';
import { site } from '@/site.config';

export type Props = HeadProps;

// 页面切换：旧页上浮淡出，新页从下方带一点模糊浮入
const pageMotion = {
  old: { name: 'page-out', duration: '0.2s', easing: 'ease-in', fillMode: 'both' },
  new: { name: 'page-in', duration: '0.5s', easing: 'cubic-bezier(0.2, 0.7, 0.2, 1)', delay: '0.06s', fillMode: 'both' },
};
const pageTransition = { forwards: pageMotion, backwards: pageMotion };
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <BaseHead {...Astro.props} />
  </head>
  <body>
    <div id="nav-progress" aria-hidden="true" transition:persist></div>
    <slot name="backdrop" />
    <Header />
    <main id="main" transition:animate={pageTransition}>
      <slot />
    </main>
    <Footer />
    <CommandPalette />
    <LinkPreview />
    <CrtMode />
  </body>
</html>

<script>
  // 卡片聚光灯：带 data-spotlight 的元素记录指针位置，CSS 画径向光斑
  document.addEventListener(
    'pointermove',
    (event) => {
      const target = (event.target as Element | null)?.closest?.<HTMLElement>('[data-spotlight]');
      if (!target) return;
      const rect = target.getBoundingClientRect();
      target.style.setProperty('--mx', `${event.clientX - rect.left}px`);
      target.style.setProperty('--my', `${event.clientY - rect.top}px`);
    },
    { passive: true },
  );

  // 页面切换时顶部的加载条
  const bar = () => document.getElementById('nav-progress');
  document.addEventListener('astro:before-preparation', () => {
    const el = bar();
    if (!el) return;
    el.dataset.state = 'idle';
    void el.offsetWidth;
    el.dataset.state = 'loading';
  });
  document.addEventListener('astro:after-swap', () => {
    const el = bar();
    if (el) el.dataset.state = 'done';
  });
</script>
