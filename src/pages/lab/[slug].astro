---
import '@/styles/lab.css';
import '@/styles/prose.css';

import BaseLayout from '@/layouts/BaseLayout.astro';
import FlowLab from '@/lab/FlowLab.astro';
import MoireLab from '@/lab/MoireLab.astro';
import { labCode, labs, type LabEntry } from '@/lab/registry';
import RidgeLab from '@/lab/RidgeLab.astro';
import ScopeLab from '@/lab/ScopeLab.astro';

export function getStaticPaths() {
  return labs.map((entry, i) => ({
    params: { slug: entry.slug },
    props: { entry, prev: labs[i - 1], next: labs[i + 1] },
  }));
}

interface Props {
  entry: LabEntry;
  prev?: LabEntry;
  next?: LabEntry;
}

const components = {
  'flow-field': FlowLab,
  moire: MoireLab,
  ridgelines: RidgeLab,
  'signal-scope': ScopeLab,
} as const;

const { entry, prev, next } = Astro.props;
const Lab = components[entry.slug as keyof typeof components];
---

<BaseLayout
  title={`${entry.title} · 实验室`}
  description={entry.description}
  image={`/og/lab--${entry.slug}.png`}
  fontText={entry.title}
>
  <section class="lab-hero" aria-labelledby="lab-title">
    <Lab />
    <header class="lab-head container">
      <a href="/lab/" class="back mono">← 实验室</a>
      <p class="code mono">{labCode(entry)} · {entry.en}</p>
      <h1 id="lab-title" transition:name={`lab-title-${entry.slug}`} data-pagefind-meta="title">{entry.title}</h1>
      <span hidden data-pagefind-meta="type:实验"></span>
    </header>
  </section>

  <section class="container notes" data-pagefind-body>
    <div class="prose">
      <p class="lede">{entry.description}</p>
      <h2 id="howto">怎么玩</h2>
      <ul>{entry.howto.map((line) => <li>{line}</li>)}</ul>
    </div>

    <nav class="pager" aria-label="相邻实验">
      {
        prev ? (
          <a href={`/lab/${prev.slug}/`} data-spotlight>
            <span class="mono">← {labCode(prev)}</span>
            <span class="t">{prev.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a href={`/lab/${next.slug}/`} class="newer" data-spotlight>
            <span class="mono">{labCode(next)} →</span>
            <span class="t">{next.title}</span>
          </a>
        )
      }
    </nav>
  </section>
</BaseLayout>

<style>
  .lab-hero {
    position: relative;
  }

  .lab-head {
    position: absolute;
    inset: 0 0 auto;
    z-index: 2;
    padding-top: var(--space-6);
    pointer-events: none;
  }

  .back {
    pointer-events: auto;
    font-size: var(--step--1);
    color: var(--fg-muted);
    text-decoration: none;
  }

  .back:hover {
    color: var(--accent-ink);
  }

  .code {
    margin-top: var(--space-5);
    font-size: var(--step--2);
    color: var(--accent-ink);
    text-transform: uppercase;
  }

  h1 {
    margin-top: var(--space-2);
    font-size: var(--step-4);
    line-height: 1.1;
    text-shadow: 0 0 24px var(--bg);
  }

  .notes {
    display: grid;
    gap: var(--space-7);
    max-width: calc(var(--measure) + var(--gutter) * 2);
    margin-left: max(0px, calc((100% - var(--max)) / 2));
    padding-top: var(--space-8);
  }

  .lede {
    font-size: var(--step-1);
    color: var(--fg-muted);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  .pager a {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
  }

  .pager a:hover {
    border-color: var(--accent-ink);
  }

  .pager .mono {
    font-size: var(--step--2);
    color: var(--fg-muted);
  }

  .pager .t {
    font-family: var(--font-serif);
    font-weight: 600;
  }

  .newer {
    grid-column: 2;
    text-align: right;
  }
</style>
